{
  "mcpServers": {
    "azure-devops": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure-devops/mcp", "your-org", "--authentication", "interactive"]
    },
    "maestro": {
      "type": "stdio",
      "command": "${HOME}/.maestro/bin/maestro",
      "args": ["mcp", "--no-viewer"]
    }
  }
}
