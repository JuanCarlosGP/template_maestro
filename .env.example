# Copia a .env (ignorado por git):  cp .env.example .env
# Entorno de desarrollo: macOS o WSL (Ubuntu). No uses rutas Windows (C:\...).
#
# Izertis Maestro Template — plantilla del framework Maestro+Gherkin.

# Azure DevOps (opcional — publicar resultados)
AZURE_DEVOPS_ORG=your-org
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_PAT=

# Azure Test Plans (opcional)
PLAN_ID=0
SUITE_ID=0
AZURE_TEST_PLAN_ID=0
AZURE_TEST_SUITE_ID=0

# App demo — sustituir por tu app real
ANDROID_APP_ID=com.example.demoapp
IOS_APP_ID=com.example.demoapp

# Nombre visible en diálogos de permisos
ANDROID_APP_NAME=Demo App
IOS_APP_NAME=Demo App

# Runner defaults
PLATFORM=all
USERNAME=demo_user
PASSWORD=demo_pass

# Build paths (destination inside this repo, gitignored)
ANDROID_BUILD=build/android/demo.apk
IOS_BUILD=build/ios/DemoApp.app

# Source paths for `make copy-builds` — set to your local app build outputs
ANDROID_SRC=
IOS_SRC=

# App source directory (relative to the root of the repo)
APP_SOURCE_DIR=../your-mobile-app

# Maestro CLI (opcional — si maestro no está en PATH)
# MAESTRO_CLI=$HOME/.maestro/bin/maestro

# Java 17+ (opcional — si java no está en PATH)
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Solo en CI con varios workers Maestro en la misma máquina.
# MAESTRO_KEEP_SESSION=1

# Solo pruebas locales (WSL + móvil USB o emulador)
# ANDROID_SERIAL=emulator-5554
